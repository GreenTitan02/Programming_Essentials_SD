int cy=250;
fill(255);
strokeWeight(3);
circle(cx,cy,250);
fill(0);
strokeWeight(1);
circle(cx+45,cy-45,20);
circle(cx-45,cy-45,20);
noFill();
strokeWeight(3);
arc(cx+45,cy-45,50,50,1*PI,2*PI);
arc(cx-45,cy-45,50,50,1*PI,2*PI);
arc(cx,cy,175,175,0*PI,1*PI);
